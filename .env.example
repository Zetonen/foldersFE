# Base URL of the backend API. The routes live at the root — there is no /api
# prefix, which is reserved for the Swagger document (/api/docs).
#
# The dev server occupies port 3000, so a backend running locally must be on a
# different one. Point this at the deployment unless you are running the API.
VITE_API_BASE_URL=https://foldersbe-production.up.railway.app
